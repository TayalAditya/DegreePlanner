# Database
DATABASE_URL="postgresql://user:password@localhost:5432/degree_planner"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Allowed Email Domain (optional, e.g., @university.edu)
ALLOWED_EMAIL_DOMAIN=""

# Gmail SMTP (for "not on Samarth" digest emails)
# GMAIL_APP_PASSWORD is a Google App Password; spaces are stripped automatically.
GMAIL_USER="b23243@students.iitmandi.ac.in"
GMAIL_APP_PASSWORD=""
# Where the Samarth-gap digest is delivered (defaults to b23243@students.iitmandi.ac.in)
SAMARTH_DIGEST_TO="b23243@students.iitmandi.ac.in"
# Optional: protect the digest cron endpoint; if set, Vercel Cron must send it as a Bearer token
CRON_SECRET=""

# Google Sheet webhook (Apps Script web app) — mirrors "not submitted on Samarth"
# reports and final course registration submissions to the Acad Sec's sheet.
# Script source: scripts/apps-script/sheet-webhook.gs
#
# Deliberately NOT hardcoded anywhere in the source. The web app is deployed with
# "Who has access: Anyone", so publishing this URL in a public repo would let
# anyone append fake rows to that sheet. Unset it and sheet mirroring is skipped.
GOOGLE_SHEET_WEBHOOK_URL=""
# Shared secret sent with every webhook POST. Must exactly match the Apps Script
# Script Property DP_SHEET_WEBHOOK_SECRET (Project Settings -> Script properties).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DP_SHEET_WEBHOOK_SECRET=""

# Question papers use a separate *private* Vercel Blob store. Do not reuse the
# public BLOB_READ_WRITE_TOKEN used by general document uploads.
PYQ_BLOB_READ_WRITE_TOKEN=""
# Preferred on Vercel: store ID used with the automatically supplied
# VERCEL_OIDC_TOKEN. This avoids a second long-lived read-write token.
PYQ_BLOB_STORE_ID=""
